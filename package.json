{
  "name": "orbit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.server.json",
    "dev:server": "tsx watch --tsconfig tsconfig.server.json src/server/main.ts",
    "build:server": "tsc --project tsconfig.server.json",
    "prisma:generate": "node scripts/generate-prisma.mjs",
    "start:server": "node server-dist/server/main.js",
    "test": "vitest run test/env.test.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:baseline:legacy": "prisma migrate resolve --applied 20261025160000_init",
    "db:verify": "prisma db execute --schema prisma/schema.prisma --file scripts/verify-db.sql",
    "check:no-demo": "node scripts/check-no-demo.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/platform-ws": "^11.2.8",
    "@nestjs/websockets": "^11.2.8",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.41.1",
    "jose": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^2.1.0"
  }
}
