# Backend runtime
NODE_ENV=development
PORT=3000
API_PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Use the provider's direct (non-pooled) URL for Prisma migrations when available.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
COOKIE_SECRET=replace-with-a-different-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5173
AUTH_COOKIE_PATH=/api/auth
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379

# Optional TURN relay; configure both values together.
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=600

# Frontend build-time values; leave unset for the local Vite proxy.
VITE_API_URL=
VITE_WS_URL=

# Optional Vite preview/development settings.
FIGMA_PUBLIC_URL=
FIGMA_DEV_SERVER_HOST=
