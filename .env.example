# Backend runtime
NODE_ENV=development
PORT=3000
API_PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Use the provider's direct (non-pooled) URL for Prisma migrations when available.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
COOKIE_SECRET=replace-with-a-different-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5173
AUTH_COOKIE_PATH=/api/auth
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379

# Optional TURN relay for networks where direct peer connections fail.
# Use either TURN_URLS with TURN_SHARED_SECRET (coturn REST auth), or
# TURN_URLS with TURN_USERNAME and TURN_CREDENTIAL (static provider credentials).
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=600

# Optional frontend build-time API URLs. Leave unset for same-origin production
# hosting and the local Vite proxy.
VITE_API_URL=
VITE_WS_URL=

# Optional Vite preview/development settings.
FIGMA_PUBLIC_URL=
FIGMA_DEV_SERVER_HOST=
